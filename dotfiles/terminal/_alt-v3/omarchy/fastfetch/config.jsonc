// omarchy — omakase tasting menu: courses with dotted leaders. (alt-v3: pixel-art logo, same greeting as alt-v2)
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{text.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "●",
        "total": "·"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 8,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;2;{{primary.rgb}}mOMAKASE\u001b[0m\u001b[38;2;{{outline.rgb}}m  ·  chef's choice, one menu\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "format": "{name} {version}",
      "key": "01 hardware "
    },
    {
      "type": "wm",
      "format": "{pretty-name}",
      "key": "02 service ·"
    },
    {
      "type": "kernel",
      "key": "03 kernel ··"
    },
    {
      "type": "shell",
      "format": "{pretty-name}",
      "key": "04 table ···"
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "05 market ··"
    },
    {
      "type": "memory",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "06 palate ··"
    },
    {
      "type": "disk",
      "folders": "/",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "07 cellar ··"
    },
    {
      "type": "packages",
      "format": "{pacman} pacman · {flatpak-all} flatpak",
      "key": "08 pantry ··"
    },
    {
      "type": "uptime",
      "key": "09 tab ·····"
    },
    {
      "type": "cpuusage",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "10 pace ····"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m◇ \u001b[0m\u001b[38;2;{{outline.rgb}}mno substitutions · we can fix everything\u001b[0m"
    }
  ]
}
