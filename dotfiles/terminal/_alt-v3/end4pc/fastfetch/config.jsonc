// end4pc — preset gallery card: tags, swatch strip, author byline. (alt-v3: pixel-art logo, same greeting as alt-v2)
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "▫"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 8,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;2;{{tertiary.rgb}}mPRESET GALLERY\u001b[0m\u001b[38;2;{{outline.rgb}}m  ·  end4-pC  ·  \u001b[0m\u001b[38;2;{{primary.rgb}}m★ 3.7k\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
    },
    {
      "type": "os",
      "format": "{name} {version}",
      "key": "preset "
    },
    {
      "type": "wm",
      "format": "{pretty-name}",
      "key": "surface"
    },
    {
      "type": "kernel",
      "key": "base   "
    },
    {
      "type": "shell",
      "format": "{pretty-name}",
      "key": "shell  "
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "silicon"
    },
    {
      "type": "memory",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "palette"
    },
    {
      "type": "disk",
      "folders": "/",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "storage"
    },
    {
      "type": "packages",
      "format": "{pacman} pacman · {flatpak-all} flatpak",
      "key": "plugins"
    },
    {
      "type": "uptime",
      "key": "runtime"
    },
    {
      "type": "cpuusage",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "traffic"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;{{primary.rgb}}m   \u001b[0m \u001b[48;2;{{secondary.rgb}}m   \u001b[0m \u001b[48;2;{{tertiary.rgb}}m   \u001b[0m \u001b[48;2;{{surfaceVariant.rgb}}m   \u001b[0m\u001b[38;2;{{outline.rgb}}m  remixed by pctrade · \u001b[0m\u001b[48;2;{{primary.rgb}}m\u001b[38;2;{{onPrimary.rgb}}m INSTALL \u001b[0m"
    }
  ]
}
