// xenon — flight control: T+ stages, thrust and propellant bars. (alt-v3: pixel-art logo, same greeting as alt-v2)
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "▪",
        "total": "▫"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 8,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;2;{{primary.rgb}}m󰈸 XENON\u001b[0m\u001b[38;2;{{outline.rgb}}m // \u001b[0m\u001b[38;2;{{text.rgb}}mFLIGHT CONTROL\u001b[0m\u001b[38;2;{{outline.rgb}}m  ·  \u001b[0m\u001b[38;2;{{tertiary.rgb}}mT−00:00:00\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{secondary.rgb}}m━━━━╸ ━━━━╸ ━━━━╸ ━━━━╸ ━━━━╸ ━━━━╸ ━━━━╸ ━━━━\u001b[0m"
    },
    {
      "type": "os",
      "format": "{name} {version}",
      "key": "T+00 mission   "
    },
    {
      "type": "wm",
      "format": "{pretty-name}",
      "key": "T+01 guidance  "
    },
    {
      "type": "kernel",
      "key": "T+02 core      "
    },
    {
      "type": "shell",
      "format": "{pretty-name}",
      "key": "T+03 comms     "
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "T+04 burn      "
    },
    {
      "type": "memory",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "T+05 lox       "
    },
    {
      "type": "disk",
      "folders": "/",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "T+06 propellant"
    },
    {
      "type": "packages",
      "format": "{pacman} pacman · {flatpak-all} flatpak",
      "key": "T+07 cargo     "
    },
    {
      "type": "uptime",
      "key": "T+08 met       "
    },
    {
      "type": "cpuusage",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "T+09 thrust    "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m󰈸 \u001b[0m\u001b[38;2;{{outline.rgb}}mall engines nominal\u001b[0m"
    }
  ]
}
