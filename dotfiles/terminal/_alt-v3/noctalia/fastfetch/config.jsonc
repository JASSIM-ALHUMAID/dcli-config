// noctalia — observatory logbook: numbered log entries under a star rule. (alt-v3: pixel-art logo, same greeting as alt-v2)
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "●",
        "total": "○"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 8,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;2;{{primary.rgb}}mNOCTALIA OBSERVATORY\u001b[0m\u001b[38;2;{{outline.rgb}}m  ·  night watch\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m·  ✦  ·  ✦  ·  ✦  ·  ✦  ·  ✦  ·  ✦  ·  ✦  ·  ✦\u001b[0m"
    },
    {
      "type": "os",
      "format": "{name} {version}",
      "key": "[01] target  "
    },
    {
      "type": "wm",
      "format": "{pretty-name}",
      "key": "[02] mirror  "
    },
    {
      "type": "kernel",
      "key": "[03] sky     "
    },
    {
      "type": "shell",
      "format": "{pretty-name}",
      "key": "[04] dome    "
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "[05] seeing  "
    },
    {
      "type": "memory",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "[06] aperture"
    },
    {
      "type": "disk",
      "folders": "/",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "[07] horizon "
    },
    {
      "type": "packages",
      "format": "{pacman} pacman · {flatpak-all} flatpak",
      "key": "[08] stars   "
    },
    {
      "type": "uptime",
      "key": "[09] exposure"
    },
    {
      "type": "cpuusage",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "[10] airmass "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m{o,o} \u001b[0m\u001b[38;2;{{outline.rgb}}mclear skies — the eyepiece is warm\u001b[0m"
    }
  ]
}
