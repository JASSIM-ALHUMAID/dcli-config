// ryoku — editorial issue: masthead, sectioned dossier, the Amaterasu red. (alt-v3: pixel-art logo, same greeting as alt-v2)
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{secondary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "▬",
        "total": "▭"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 8,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;2;{{text.rgb}}mRYOKU\u001b[0m\u001b[38;2;{{outline.rgb}}m · \u001b[0m\u001b[1m\u001b[38;2;{{error.rgb}}mISSUE 1.0\u001b[0m\u001b[38;2;{{outline.rgb}}m · \u001b[0m\u001b[38;2;{{tertiary.rgb}}mAMATERASU\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m01 \u001b[0m\u001b[1m\u001b[38;2;{{text.rgb}}mSYSTEM\u001b[0m"
    },
    {
      "type": "os",
      "format": "{name} {version}",
      "key": "edition  "
    },
    {
      "type": "wm",
      "format": "{pretty-name}",
      "key": "session  "
    },
    {
      "type": "kernel",
      "key": "kernel   "
    },
    {
      "type": "shell",
      "format": "{pretty-name}",
      "key": "shell    "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m02 \u001b[0m\u001b[1m\u001b[38;2;{{text.rgb}}mVITALS\u001b[0m"
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "processor"
    },
    {
      "type": "cpuusage",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "load     "
    },
    {
      "type": "memory",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "memory   "
    },
    {
      "type": "disk",
      "folders": "/",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      },
      "key": "storage  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m03 \u001b[0m\u001b[1m\u001b[38;2;{{text.rgb}}mSESSION\u001b[0m"
    },
    {
      "type": "packages",
      "format": "{pacman} pacman · {flatpak-all} flatpak",
      "key": "packages "
    },
    {
      "type": "uptime",
      "key": "uptime   "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m力\u001b[0m\u001b[38;2;{{outline.rgb}}mと美のために · for the sake of power and beauty\u001b[0m"
    }
  ]
}
