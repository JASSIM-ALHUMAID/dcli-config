// ambxst — the notch and the blob: a dark island header, the sticker in primary->tertiary.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{primary.rgb}}",
      "2": "38;2;{{secondary.rgb}}",
      "3": "38;2;{{tertiary.rgb}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;{{surfaceContainer.rgb}}m\u001b[48;2;{{surfaceContainer.rgb}}m\u001b[1;38;2;{{primary.rgb}}m  {$USER} · ambxst  \u001b[0m\u001b[38;2;{{surfaceContainer.rgb}}m\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "󰣇  os       ",
      "keyColor": "38;2;{{primary.rgb}}"
    },
    {
      "type": "kernel",
      "key": "󰌽  kernel   ",
      "keyColor": "38;2;{{primary.rgb}}"
    },
    {
      "type": "wm",
      "key": "󰕮  wm       ",
      "keyColor": "38;2;{{secondary.rgb}}",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "󰏖  packages ",
      "keyColor": "38;2;{{secondary.rgb}}"
    },
    {
      "type": "cpu",
      "key": "󰻠  cpu      ",
      "keyColor": "38;2;{{tertiary.rgb}}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛  memory   ",
      "keyColor": "38;2;{{tertiary.rgb}}"
    },
    {
      "type": "uptime",
      "key": "󰔟  uptime   ",
      "keyColor": "38;2;{{tertiary.rgb}}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m  •\u001b[38;2;{{secondary.rgb}}m  :\u001b[38;2;{{tertiary.rgb}}m  •   \u001b[38;2;{{outline.rgb}}maxtremely customizable\u001b[0m"
    }
  ]
}
