// xenon — the flame: a fire-gradient logo, a lean list, the CPU's heat.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;255;106;0",
      "2": "38;2;255;61;31",
      "3": "38;2;255;149;0",
      "4": "38;2;255;208;0",
      "5": "38;2;158;27;15"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;255;208;0m󰈸 \u001b[1m\u001b[38;2;255;149;0mxenon\u001b[0m\u001b[38;2;{{outline.rgb}}m · \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;208;0m━━━━\u001b[38;2;255;149;0m━━━━━\u001b[38;2;255;106;0m━━━━━\u001b[38;2;255;61;31m━━━━\u001b[38;2;158;27;15m━━━\u001b[0m"
    },
    {
      "type": "os",
      "key": "󰣇  os     "
    },
    {
      "type": "kernel",
      "key": "󰌽  kernel "
    },
    {
      "type": "wm",
      "key": "󰕮  wm     ",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "󰻠  cpu    ",
      "temp": true,
      "format": "{name}  {temperature}",
      "keyColor": "38;2;255;149;0"
    },
    {
      "type": "memory",
      "key": "󰍛  memory "
    },
    {
      "type": "uptime",
      "key": "󰔟  uptime "
    }
  ]
}
