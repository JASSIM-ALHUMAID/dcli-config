// glyph (alt) — a dot-matrix g: ANSI colours only so a light terminal theme can swap them.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "97",
      "2": "31"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "37",
      "title": "97",
      "output": "97",
      "separator": "90"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "1;37",
        "at": "90",
        "host": "1;97"
      }
    },
    {
      "type": "separator",
      "string": "·",
      "outputColor": "90"
    },
    {
      "type": "os",
      "key": "os        "
    },
    {
      "type": "kernel",
      "key": "kernel    ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "wm        ",
      "format": "{pretty-name}"
    },
    {
      "type": "command",
      "key": "shell     ",
      "text": "echo 'quickshell · glyph'"
    },
    {
      "type": "terminal",
      "key": "term      ",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime    "
    },
    {
      "type": "memory",
      "key": "memory    "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
