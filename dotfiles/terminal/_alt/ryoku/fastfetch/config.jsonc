// ryoku (alt) — a scroll: kanji-numbered sections, signed with a hanko seal.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;243;237;225",
      "2": "38;2;226;52;42"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;226;52;42m一\u001b[0m  \u001b[1m\u001b[38;2;{{text.rgb}}mVITALS\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "   cpu     ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "   memory  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;226;52;42m二\u001b[0m  \u001b[1m\u001b[38;2;{{text.rgb}}mSYSTEM\u001b[0m"
    },
    {
      "type": "os",
      "key": "   os      "
    },
    {
      "type": "kernel",
      "key": "   kernel  "
    },
    {
      "type": "wm",
      "key": "   wm      ",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;226;52;42m三\u001b[0m  \u001b[1m\u001b[38;2;{{text.rgb}}mSESSION\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "   uptime  "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;226;52;42m\u001b[1;38;2;243;237;225m 力 \u001b[0m  \u001b[38;2;{{outline.rgb}}mryoku · \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    }
  ]
}
