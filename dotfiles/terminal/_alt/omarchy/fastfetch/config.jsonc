// omarchy (alt) — keycaps: every field labelled like a key, brackets like the logo.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{primary.rgb}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;2;{{primary.rgb}}momarchy\u001b[0m\u001b[38;2;{{outline.rgb}}m · omakase, on \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m   os   \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m kernel \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m   wm   \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m  term  \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m  cpu   \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m memory \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;{{outline.rgb}}m[\u001b[0m\u001b[1m\u001b[38;2;{{primary.rgb}}m uptime \u001b[0m\u001b[38;2;{{outline.rgb}}m]\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m[\u001b[38;2;{{primary.rgb}}msuper\u001b[38;2;{{outline.rgb}}m] + [\u001b[38;2;{{primary.rgb}}mspace\u001b[38;2;{{outline.rgb}}m]  launcher\u001b[0m"
    }
  ]
}
