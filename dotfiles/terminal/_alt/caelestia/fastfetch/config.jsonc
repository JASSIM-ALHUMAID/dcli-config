// caelestia (alt) — the dashboard: date and time, now playing, then the system.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{primary.rgb}}",
      "2": "38;2;{{tertiary.rgb}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "datetime",
      "key": " ",
      "format": "\u001b[1m\u001b[38;2;{{primary.rgb}}m{weekday}, {day-in-month} {month-name}\u001b[0m\u001b[38;2;{{outline.rgb}}m  ·  \u001b[0m\u001b[38;2;{{tertiary.rgb}}m{hour-pretty}:{minute-pretty}\u001b[0m"
    },
    {
      "type": "media",
      "key": "󰎈  playing  ",
      "keyColor": "38;2;{{tertiary.rgb}}",
      "format": "{title} — {artist}"
    },
    "break",
    {
      "type": "os",
      "key": "󰣇  os       "
    },
    {
      "type": "wm",
      "key": "󰕮  wm       ",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "󰻠  cpu      ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛  memory   "
    },
    {
      "type": "uptime",
      "key": "󰔟  uptime   "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m  󰙴  \u001b[38;2;{{outline.rgb}}mcaelestia · \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    }
  ]
}
