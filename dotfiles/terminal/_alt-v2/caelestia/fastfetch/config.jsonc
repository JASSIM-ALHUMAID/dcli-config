// caelestia (alt-v2) — the aurora tank: a full-width fluid surface instead of
// a left-hand logo. Density bars are the tank's live readout.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{tertiary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "key": { "width": 10 },
    "bar": {
      "char": { "elapsed": "▰", "total": "▱" },
      "border": { "left": "", "right": "" },
      "width": 20,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{surfaceVariant.rgb}}"
      }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{secondary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m╭──────────────────────────────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m│\u001b[0m  \u001b[1m\u001b[38;2;{{primary.rgb}}m✦  CAELESTIA\u001b[0m   \u001b[38;2;{{outline.rgb}}m·\u001b[0m   \u001b[3m\u001b[38;2;{{tertiary.rgb}}mFLUID IDENTITY\u001b[0m                                   \u001b[38;2;{{primary.rgb}}m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m╰──────────────────────────────────────────────────────────────────────╯\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m▁▂▃▄▅▆▇█▇▆▅▄▃▂▁▁▂▃▄▅▆▇█▇▆▅▄▃▂▁▁▂▃▄▅▆▇█▇▆▅▄▃▂▁▁▂▃▄▅▆▇█▇▆▅▄▃▂▁▁▂▃▄▅▆▇█▇▆\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{secondary.rgb}}m░▒▓████▓▒░░░▒▓████▓▒░░░▒▓████▓▒░░░▒▓████▓▒░░░▒▓████▓▒░░░▒▓████▓▒\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m▒▓██████▓▒▒▓██████▓▒▒▓██████▓▒▒▓██████▓▒▒▓██████▓▒▒▓██████▓▒\u001b[0m"
    },
    "break",
    {
      "type": "cpuusage",
      "key": "density",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "memory",
      "key": "memory",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "disk",
      "key": "tank",
      "folders": "/",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "os",
      "key": "system",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "surface",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "stars"
    },
    {
      "type": "uptime",
      "key": "current"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m  ✦  orbit stable   \u001b[38;2;{{primary.rgb}}m·\u001b[38;2;{{secondary.rgb}}m·\u001b[38;2;{{tertiary.rgb}}m·\u001b[0m"
    }
  ]
}
