// ryoku (alt-v2) — Issue 1.0 / Amaterasu. The greeting is a magazine cover:
// block masthead, 力と美のために, numbered editorial sections, a red seal.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{outline.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "key": { "width": 12 },
    "bar": {
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "", "right": "" },
      "width": 14,
      "color": {
        "elapsed": "38;2;226;52;42",
        "total": "38;2;{{surfaceVariant.rgb}}"
      }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": {
        "green": "38;2;226;52;42",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;226;52;42"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;{{text.rgb}}m████  █   █  ███  █   █ █   █\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{text.rgb}}m█   █ █   █ █   █ █  █  █   █\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{text.rgb}}m████   ███  █   █ ███   █   █\u001b[0m  \u001b[38;2;226;52;42m●\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{text.rgb}}m█  █    █   █   █ █  █  █   █\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{text.rgb}}m█   █   █    ███  █   █  ███ \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;226;52;42mISSUE 1.0\u001b[0m \u001b[38;2;{{outline.rgb}}m·\u001b[0m \u001b[1m\u001b[38;2;{{text.rgb}}mAMATERASU\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;226;52;42m力と美のために\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[3m\u001b[38;2;{{outline.rgb}}mfor the sake of power and beauty\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;226;52;42m01 / VITALS\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "processor",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "memory",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "disk",
      "key": "storage",
      "folders": "/",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;226;52;42m02 / SYSTEM\u001b[0m"
    },
    {
      "type": "os",
      "key": "edition",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "session",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;226;52;42m03 / SESSION\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "packages",
      "format": "{pacman} pacman · {flatpak-user} flatpak"
    },
    {
      "type": "custom",
      "key": "observer",
      "format": "{$USER}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[3m\u001b[38;2;{{text.rgb}}m“Show it off on Sunday. Forget it’s there on Monday.”\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[48;2;226;52;42m\u001b[38;2;243;237;225m 力 \u001b[0m  \u001b[38;2;{{outline.rgb}}mRYOKU · a hand-built desktop\u001b[0m"
    }
  ]
}
