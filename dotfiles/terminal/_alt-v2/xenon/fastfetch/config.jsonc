// xenon (alt-v2) — flight control: ignition stack, thrust/LOX/propellant
// telemetry, a flame plume, and every field stamped with its T+ mark.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{primary.rgb}}",
      "2": "38;2;{{secondary.rgb}}",
      "3": "38;2;{{tertiary.rgb}}"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "", "right": "" },
      "width": 16,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{surfaceVariant.rgb}}"
      }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{secondary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{primary.rgb}}mXENON // FLIGHT CONTROL\u001b[0m  \u001b[38;2;{{outline.rgb}}m· ignition sequence\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}mT−00:00:00\u001b[0m  \u001b[38;2;{{primary.rgb}}mIGNITION\u001b[0m  \u001b[38;2;{{outline.rgb}}m· all systems go\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m▁▂▃▄▅▆▇█▇▆▅▄▃▂▁\u001b[38;2;{{secondary.rgb}}m▁▂▃▄▅▆▇█▇▆▅▄▃▂▁\u001b[38;2;{{tertiary.rgb}}m▁▂▃▄▅▆▇█▇▆▅▄▃▂▁\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "T+00  MISSION     ",
      "format": "{name} {version}"
    },
    {
      "type": "wm",
      "key": "T+01  GUIDANCE    ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "T+02  COMMS       ",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "T+03  CORE        ",
      "temp": true,
      "format": "{name}  {temperature}"
    },
    {
      "type": "cpuusage",
      "key": "T+04  THRUST      ",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "memory",
      "key": "T+05  LOX         ",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "disk",
      "key": "T+06  PROPELLANT  ",
      "folders": "/",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "packages",
      "key": "T+07  CARGO       ",
      "format": "{pacman} pacman · {flatpak-user} flatpak"
    },
    {
      "type": "uptime",
      "key": "T+08  MET         "
    },
    {
      "type": "battery",
      "key": "T+09  FUEL        ",
      "percent": { "type": ["bar", "num"] }
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{primary.rgb}}m󰈸\u001b[0m \u001b[38;2;{{secondary.rgb}}m▁▂▃▄▅▆▇█▇▆▅▄▃▂▁\u001b[0m \u001b[38;2;{{tertiary.rgb}}m▁▂▃▄▅▆▇█▇▆▅▄▃▂▁\u001b[0m  \u001b[38;2;{{outline.rgb}}mall engines nominal · {$USER} at the stick\u001b[0m"
    }
  ]
}
