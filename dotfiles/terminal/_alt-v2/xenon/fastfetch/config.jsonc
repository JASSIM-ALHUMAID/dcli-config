// alt-v2 placeholder — replaced by the shell's own identity below.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;{{primary.rgb}}" }
  },
  "display": {
    "color": { "keys": "38;2;{{primary.rgb}}", "output": "38;2;{{text.rgb}}" }
  },
  "modules": ["title", "os", "kernel", "wm", "cpu", "memory", "uptime"]
}
