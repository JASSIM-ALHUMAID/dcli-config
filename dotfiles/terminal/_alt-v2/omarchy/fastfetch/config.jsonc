// omarchy (alt-v2) — the omakase menu: courses with dotted leaders, a
// CHEF'S CHOICE stamp, and the doctrine as the last line. No substitutions.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{primary.rgb}}",
      "2": "38;2;{{tertiary.rgb}}"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": { "elapsed": "●", "total": "○" },
      "border": { "left": "", "right": "" },
      "width": 12,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{surfaceVariant.rgb}}"
      }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{primary.rgb}}mOMA // OMAKASE\u001b[0m  \u001b[38;2;{{outline.rgb}}m·  chef's choice, one menu\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m╭──────────────────╮\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m│\u001b[0m  \u001b[1m\u001b[38;2;{{error.rgb}}mCHEF'S CHOICE\u001b[0m   \u001b[38;2;{{error.rgb}}m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{error.rgb}}m╰──────────────────╯\u001b[0m  \u001b[38;2;{{outline.rgb}}mten principles · nothing to configure\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "COURSE 01  hardware ......... ",
      "format": "{name} {version}"
    },
    {
      "type": "wm",
      "key": "COURSE 02  service .......... ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "COURSE 03  table ............ ",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "COURSE 04  market ........... ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "COURSE 05  palate ........... ",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "packages",
      "key": "COURSE 06  cellar ........... ",
      "format": "{pacman} pacman · {flatpak-user} flatpak"
    },
    {
      "type": "uptime",
      "key": "COURSE 07  tab .............. "
    },
    {
      "type": "custom",
      "key": "COURSE 08  doctrine ......... ",
      "format": "We can fix everything."
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{error.rgb}}mNO SUBSTITUTIONS\u001b[0m  \u001b[38;2;{{outline.rgb}}m·  served with an opinion · \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    }
  ]
}
