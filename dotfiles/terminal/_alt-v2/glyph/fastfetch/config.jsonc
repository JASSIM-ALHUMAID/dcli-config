// glyph (alt-v2) — a Nothing OS Glyph Matrix panel: white dots, dim dot meters,
// and exactly one red pixel that is always live.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{text.rgb}}",
      "2": "38;2;{{primary.rgb}}"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{text.rgb}}",
      "output": "38;2;{{secondary.rgb}}"
    },
    "bar": {
      "char": { "elapsed": "●", "total": "○" },
      "border": { "left": "", "right": "" },
      "width": 10,
      "color": {
        "elapsed": "38;2;{{text.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": {
        "green": "38;2;{{text.rgb}}",
        "yellow": "38;2;{{text.rgb}}",
        "red": "38;2;{{primary.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{text.rgb}}mGLYPH // MATRIX 01\u001b[0m  \u001b[38;2;{{secondary.rgb}}mNOTHING OS\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{secondary.rgb}}m● ○ ● ○ ● ○ ● ○ ● ○ ● ○ ● ○ ● ○ ● ○ ● ○\u001b[0m"
    },
    {
      "type": "os",
      "key": "● os        ",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "● kernel    "
    },
    {
      "type": "wm",
      "key": "● surface   ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "● shell     ",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "● cpu       ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "● memory    ",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "disk",
      "key": "● storage   ",
      "folders": "/",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "packages",
      "key": "● packages  ",
      "format": "{pacman} pacman · {flatpak-user} flatpak"
    },
    {
      "type": "uptime",
      "key": "● uptime    "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{primary.rgb}}m●\u001b[0m \u001b[38;2;{{secondary.rgb}}mLIVE\u001b[0m  \u001b[38;2;{{secondary.rgb}}mthe one red pixel on the panel\u001b[0m"
    }
  ]
}
