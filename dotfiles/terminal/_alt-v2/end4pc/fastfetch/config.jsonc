// end4pc (alt-v2) — a shareable preset card from the end4-pC community gallery:
// title, star count, swatch strip, tags, then the machine it was rendered on.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{tertiary.rgb}}",
      "2": "38;2;{{primary.rgb}}",
      "3": "38;2;{{secondary.rgb}}"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{tertiary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "", "right": "" },
      "width": 14,
      "color": {
        "elapsed": "38;2;{{tertiary.rgb}}",
        "total": "38;2;{{surfaceVariant.rgb}}"
      }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": {
        "green": "38;2;{{tertiary.rgb}}",
        "yellow": "38;2;{{secondary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;{{tertiary.rgb}}mPRESET GALLERY\u001b[0m  \u001b[38;2;{{outline.rgb}}m· end4-pC · community presets\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m╭─\u001b[0m \u001b[1;38;2;{{tertiary.rgb}}mpC-001\u001b[0m \u001b[38;2;{{outline.rgb}}m──────────────────────────────\u001b[0m \u001b[38;2;{{primary.rgb}}m★ 3.7k\u001b[0m \u001b[38;2;{{outline.rgb}}m─╮\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m│\u001b[0m \u001b[1m\u001b[38;2;{{text.rgb}}m\"Material 3 Expressive\"\u001b[0m \u001b[38;2;{{outline.rgb}}m· remixed by pctrade\u001b[0m   \u001b[38;2;{{outline.rgb}}m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m│\u001b[0m \u001b[38;2;{{primary.rgb}}m███\u001b[38;2;{{secondary.rgb}}m███\u001b[38;2;{{tertiary.rgb}}m███\u001b[38;2;{{error.rgb}}m███\u001b[38;2;{{text.rgb}}m███\u001b[38;2;{{outline.rgb}}m███\u001b[0m  \u001b[38;2;{{outline.rgb}}m#material3 #expressive\u001b[0m     \u001b[38;2;{{outline.rgb}}m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m╰────────────────────────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "preset   ",
      "format": "{name} {version}"
    },
    {
      "type": "wm",
      "key": "surface  ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "base     "
    },
    {
      "type": "cpu",
      "key": "silicon  ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "palette  ",
      "percent": { "type": ["bar", "num"] }
    },
    {
      "type": "packages",
      "key": "plugins  ",
      "format": "{pacman} pacman · {flatpak-user} flatpak"
    },
    {
      "type": "uptime",
      "key": "runtime  "
    },
    {
      "type": "custom",
      "key": "author   ",
      "format": "pctrade · verified preset"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m[ DOWNLOAD ]\u001b[0m  \u001b[38;2;{{primary.rgb}}m[ INSTALL ]\u001b[0m  \u001b[38;2;{{outline.rgb}}m· share the whole desktop in one click\u001b[0m"
    }
  ]
}
