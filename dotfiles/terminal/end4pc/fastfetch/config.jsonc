// end4pc — illogical-impulse remixed: mirrored logo, a B-side tracklist.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{tertiary.rgb}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{tertiary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 16,
      "color": {
        "elapsed": "38;2;{{tertiary.rgb}}",
        "total": "38;2;{{surfaceVariant.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m󰛄 \u001b[1m\u001b[38;2;{{tertiary.rgb}}m illogical impulse\u001b[0m\u001b[38;2;{{outline.rgb}}m · remixed by pctrade\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "\u001b[38;2;{{outline.rgb}}m01\u001b[0m  \u001b[1m\u001b[38;2;{{tertiary.rgb}}mos      \u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;{{outline.rgb}}m02\u001b[0m  \u001b[1m\u001b[38;2;{{tertiary.rgb}}mkernel  \u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;{{outline.rgb}}m03\u001b[0m  \u001b[1m\u001b[38;2;{{tertiary.rgb}}mwm      \u001b[0m",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;{{outline.rgb}}m04\u001b[0m  \u001b[1m\u001b[38;2;{{tertiary.rgb}}mcpu     \u001b[0m",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;{{outline.rgb}}m05\u001b[0m  \u001b[1m\u001b[38;2;{{tertiary.rgb}}mmemory  \u001b[0m",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      }
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;{{outline.rgb}}m06\u001b[0m  \u001b[1m\u001b[38;2;{{tertiary.rgb}}muptime  \u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{tertiary.rgb}}m 󰐊  \u001b[38;2;{{text.rgb}}mside B\u001b[38;2;{{outline.rgb}}m  ·  now playing on \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    }
  ]
}
