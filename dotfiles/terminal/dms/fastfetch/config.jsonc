// dms — Dux Shell's spy duck: the greeting is a field dossier.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{primary.rgb}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[48;2;{{error.rgb}}m\u001b[1;38;2;{{background.rgb}}m CLASSIFIED \u001b[0m  \u001b[1m\u001b[38;2;{{primary.rgb}}mDUX · FIELD REPORT\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "title",
      "key": "AGENT    ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "OS       "
    },
    {
      "type": "kernel",
      "key": "KERNEL   "
    },
    {
      "type": "wm",
      "key": "WM       ",
      "format": "{pretty-name}"
    },
    {
      "type": "command",
      "key": "SHELL    ",
      "text": "echo 'dux shell'"
    },
    {
      "type": "cpu",
      "key": "CPU      ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "MEMORY   "
    },
    {
      "type": "uptime",
      "key": "ON DUTY  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{surfaceVariant.rgb}}m█████ ███████ ███ ████\u001b[0m  \u001b[38;2;{{outline.rgb}}meyes only\u001b[0m"
    }
  ]
}
