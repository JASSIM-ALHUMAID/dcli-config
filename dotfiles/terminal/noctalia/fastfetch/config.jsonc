// noctalia — the owl on the moon: brand-yellow crescent, fields bulleted by moon phase.
// Rendered with the shell's live palette by scripts/apply-terminal-theme.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;255;245;155",
      "2": "38;2;{{primary.rgb}}",
      "3": "38;2;{{text.rgb}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{primary.rgb}}",
      "output": "38;2;{{text.rgb}}"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;255;245;155m󰖔  \u001b[1m\u001b[38;2;{{primary.rgb}}mnoctalia\u001b[0m\u001b[38;2;{{outline.rgb}}m · night watch on \u001b[0m\u001b[38;2;{{text.rgb}}m{$USER}\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "󰽤  os       ",
      "keyColor": "38;2;255;245;155"
    },
    {
      "type": "kernel",
      "key": "󰽧  kernel   ",
      "keyColor": "38;2;255;245;155"
    },
    {
      "type": "wm",
      "key": "󰽡  wm       ",
      "keyColor": "38;2;255;245;155",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "󰽨  packages ",
      "keyColor": "38;2;255;245;155"
    },
    {
      "type": "cpu",
      "key": "󰽢  cpu      ",
      "keyColor": "38;2;255;245;155",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰽦  memory   ",
      "keyColor": "38;2;255;245;155"
    },
    {
      "type": "uptime",
      "key": "󰽣  awake    ",
      "keyColor": "38;2;255;245;155"
    },
    {
      "type": "terminal",
      "key": "󰽥  terminal ",
      "keyColor": "38;2;255;245;155",
      "format": "{pretty-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m  ·    *      ·   ⋆       ·     *\u001b[0m"
    }
  ]
}
