// horizon — the sky over Riyadh as the logo, an almanac and the machine beside it.
// The logo and the first four lines are painted ahead by scripts/paint-terminal-art.sh
// into {{live}}; if they are missing fastfetch falls back to the distro logo and the
// lines print empty. Text column <= 32 cells so 80 columns never crop it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "iterm",
    "source": "{{live}}/logo.png",
    "width": 44,
    "height": 12,
    "preserveAspectRatio": true,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{outline.rgb}}",
      "output": "38;2;{{text.rgb}}"
    },
    "bar": {
      "char": {
        "elapsed": "●",
        "total": "○"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 8,
      "color": {
        "elapsed": "38;2;{{primary.rgb}}",
        "total": "38;2;{{outline.rgb}}"
      }
    },
    "percent": {
      "type": [
        "bar"
      ],
      "color": {
        "green": "38;2;{{primary.rgb}}",
        "yellow": "38;2;{{tertiary.rgb}}",
        "red": "38;2;{{error.rgb}}"
      }
    }
  },
  "modules": [
    {
      "type": "command",
      "text": "cat '{{live}}/place' 2>/dev/null",
      "key": " ",
      "outputColor": "1;38;2;{{text.rgb}}",
      "format": "{result}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
    },
    {
      "type": "command",
      "text": "cat '{{live}}/sky' 2>/dev/null",
      "key": "\u001b[38;2;{{tertiary.rgb}}m○\u001b[0m",
      "outputColor": "38;2;{{tertiary.rgb}}",
      "format": "{result}"
    },
    {
      "type": "command",
      "text": "cat '{{live}}/almanac' 2>/dev/null",
      "key": "\u001b[38;2;{{secondary.rgb}}m◆\u001b[0m",
      "outputColor": "38;2;{{secondary.rgb}}",
      "format": "{result}"
    },
    {
      "type": "command",
      "text": "cat '{{live}}/daylight' 2>/dev/null",
      "key": "\u001b[38;2;{{secondary.rgb}}m◇\u001b[0m",
      "format": "{result}"
    },
    {
      "type": "command",
      "text": "cat '{{live}}/moon' 2>/dev/null",
      "key": "\u001b[38;2;{{primary.rgb}}m☾\u001b[0m",
      "outputColor": "38;2;{{primary.rgb}}",
      "format": "{result}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{outline.rgb}}m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{host-name}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "up",
      "format": "{formatted}"
    },
    {
      "type": "memory",
      "key": "mem",
      "percent": { "type": ["bar"] },
      "format": "{percentage-bar} {used}"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/",
      "percent": { "type": ["bar"] },
      "format": "{size-percentage-bar} {size-used}"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "format": "{cores-logical} threads"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{all}"
    }
  ]
}
