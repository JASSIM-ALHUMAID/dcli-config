#!/bin/bash
# Root side of the GRUB theming layer. Installed root-owned as
# /usr/local/libexec/dcli-grub-sync and run by dcli-grub-theme.service whenever
# the user's renderer touches <staging>/.stamp. Never runs from the repo.
#
# Usage: dcli-grub-sync --user <login> --staging <dir>
#
# Threat model: <staging> is writable by the user, this script is root. So the
# staging tree is never read as root. It is archived BY THE USER (setpriv drops
# to their uid/gid, no supplementary groups) into a root-owned temp dir, where
# the stream is treated as hostile: size-capped, member types listed and
# restricted to files and directories before anything is extracted, then every
# extracted file is re-checked (name, size, magic bytes, theme.txt references)
# before `install` copies it under /boot/grub/themes/dcli. Nothing from the
# staging tree is executed or sourced.
#
# Overrides (tests only, honoured as given — they come from root's own
# environment, which the systemd unit does not populate):
#   DCLI_GRUB_DEST         install root          (/boot/grub/themes/dcli)
#   DCLI_GRUB_READER       command prefix that reads as the user
#                          (default: setpriv --reuid=<uid> --regid=<gid> --clear-groups)
#   DCLI_GRUB_MKCONFIG     grub-mkconfig command (grub-mkconfig -o /boot/grub/grub.cfg)
#   DCLI_GRUB_ALLOW_NONROOT=1  skip the euid check

set -euo pipefail
umask 077

# ── Constants ────────────────────────────────────────────────────────────────
DEST="${DCLI_GRUB_DEST:-/boot/grub/themes/dcli}"
MKCONFIG_CMD="${DCLI_GRUB_MKCONFIG:-grub-mkconfig -o /boot/grub/grub.cfg}"
ACTIVE_DIR_NAME=active
ACTIVE_MARKER=.dcli-shell
FONTS_DIR_NAME=fonts
TAR_TIMEOUT_SECS=60
MAX_STREAM_BYTES=$((128 * 1024 * 1024))
MAX_FILE_BYTES=$((8 * 1024 * 1024))
MAX_TEXT_BYTES=$((64 * 1024))
MAX_TITLE_BYTES=256
MAX_SHELLS=64
MAX_FILES_PER_SHELL=400
MAX_DEPTH=3
NAME_RE='^[A-Za-z0-9._-]+$'
SHELL_RE='^[a-z0-9][a-z0-9-]*$'
# Created by this script, never user content.
WORK=""

log() { printf 'dcli-grub-sync: %s\n' "$*"; }
err() { printf 'dcli-grub-sync: !! %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

cleanup() { [ -z "$WORK" ] || rm -rf "${WORK:?}"; }
trap cleanup EXIT

# ── Arguments ────────────────────────────────────────────────────────────────
TARGET_USER=""
STAGING=""
while [ $# -gt 0 ]; do
    case "$1" in
    --user) TARGET_USER="${2:-}"; shift 2 || die "--user needs a value" ;;
    --staging) STAGING="${2:-}"; shift 2 || die "--staging needs a value" ;;
    *) die "usage: dcli-grub-sync --user <login> --staging <dir>" ;;
    esac
done
[ -n "$TARGET_USER" ] && [ -n "$STAGING" ] || die "usage: dcli-grub-sync --user <login> --staging <dir>"
case "$STAGING" in /*) ;; *) die "--staging must be an absolute path" ;; esac

if [ "${DCLI_GRUB_ALLOW_NONROOT:-0}" != 1 ] && [ "$(id -u)" -ne 0 ]; then
    die "must run as root"
fi

user_entry=$(getent passwd "$TARGET_USER") || die "unknown user: $TARGET_USER"
IFS=: read -r _ _ TARGET_UID TARGET_GID _ <<<"$user_entry"
if [ "${DCLI_GRUB_ALLOW_NONROOT:-0}" != 1 ] && [ "$TARGET_UID" -eq 0 ]; then
    die "refusing to treat root as the staging owner"
fi

if [ -n "${DCLI_GRUB_READER:-}" ]; then
    # shellcheck disable=SC2206  # intentional word split of a command prefix
    READER=($DCLI_GRUB_READER)
else
    READER=(setpriv --reuid="$TARGET_UID" --regid="$TARGET_GID" --clear-groups)
fi

# ── Fetch: archive as the user, extract as root into a private temp ──────────
fetch_staging() {
    local stream="$WORK/stage.tar" size member_types escaping
    RAW="$WORK/raw"
    mkdir -p "$RAW"

    # head -c cap+1 turns an oversized stream into a detectable overflow instead
    # of an unbounded write; the user's tar is killed by SIGPIPE/timeout.
    # Previews and the renderer's font MANIFEST (its pf2 → GRUB-name ledger) are
    # bookkeeping, never installed, so they are not even read.
    timeout "$TAR_TIMEOUT_SECS" "${READER[@]}" \
        tar -C "$STAGING" -cf - --exclude=preview.png --exclude=contact-sheet.png --exclude='*.tmp' \
        --exclude=./fonts/MANIFEST . |
        head -c $((MAX_STREAM_BYTES + 1)) >"$stream" || die "could not archive $STAGING as $TARGET_USER"
    size=$(stat -c %s "$stream")
    [ "$size" -le "$MAX_STREAM_BYTES" ] || die "staging archive exceeds $MAX_STREAM_BYTES bytes"

    # The first character of every verbose-listing line is the member type. A
    # hostile name with an embedded newline can only add lines, never hide one,
    # so any line that does not start with "-" or "d" rejects the whole archive.
    member_types=$(tar -tvf "$stream" | cut -c1 | sort -u) || die "unreadable staging archive"
    case "$member_types" in
    "-" | "d" | "-"$'\n'"d" | "d"$'\n'"-") ;;
    *) die "staging archive holds members other than files and directories" ;;
    esac
    # Counted, not `grep -q`: under pipefail an early-exiting grep would turn
    # tar's SIGPIPE into a false "no match".
    escaping=$(tar -tf "$stream" | grep -Ec '(^|/)\.\.(/|$)|^/' || true)
    [ "$escaping" -eq 0 ] || die "staging archive has path-escaping member names"
    tar -C "$RAW" -xf "$stream" --no-same-owner --no-same-permissions ||
        die "could not extract staging archive"
    rm -f "$stream"
}

# ── Validation ───────────────────────────────────────────────────────────────
# Prints the first 8 bytes of a file as hex.
head_hex() { head -c "${2:-8}" "$1" | od -An -tx1 | tr -d ' \n'; }

file_size() { stat -c %s "$1"; }

# True when the file has no control bytes besides tab, CR and LF (NUL included).
# theme.txt and title.txt are UTF-8 prose.
is_plain_text() { ! LC_ALL=C grep -qaP '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$1"; }

in_list() {
    local want="$1" x
    shift
    for x in "$@"; do [ "$x" = "$want" ] && return 0; done
    return 1
}

# theme.txt may only reference files inside its own directory: every quoted
# string must be free of "..", absolute or device-style prefixes, "$" and "\".
theme_references_ok() {
    local file="$1" quoted
    while IFS= read -r quoted; do
        case "$quoted" in
        *..* | /* | '('* | *'$'* | *\\*) return 1 ;;
        esac
    done < <(grep -o '"[^"]*"' "$file" | sed 's/^"//; s/"$//')
    return 0
}

# check_file <path> <relative name>; returns 0 if allowed.
check_file() {
    local path="$1" rel="$2" base size
    base=${rel##*/}
    [[ "$base" =~ $NAME_RE ]] || { err "${root##*/}/$rel: bad file name"; return 1; }
    size=$(file_size "$path")
    [ "$size" -le "$MAX_FILE_BYTES" ] || { err "${root##*/}/$rel: larger than $MAX_FILE_BYTES bytes"; return 1; }
    case "$base" in
    theme.txt)
        [ "$size" -le "$MAX_TEXT_BYTES" ] || { err "${root##*/}/$rel: theme.txt too large"; return 1; }
        is_plain_text "$path" || { err "${root##*/}/$rel: not plain text"; return 1; }
        theme_references_ok "$path" || { err "${root##*/}/$rel: theme.txt references a path outside its directory"; return 1; }
        ;;
    title.txt)
        [ "$size" -le "$MAX_TITLE_BYTES" ] || { err "${root##*/}/$rel: title.txt too large"; return 1; }
        is_plain_text "$path" || { err "${root##*/}/$rel: not plain text"; return 1; }
        ;;
    *.png)
        [ "$(head_hex "$path" 8)" = 89504e470d0a1a0a ] || { err "${root##*/}/$rel: not a PNG"; return 1; }
        ;;
    *.jpg)
        [ "$(head_hex "$path" 3)" = ffd8ff ] || { err "${root##*/}/$rel: not a JPEG"; return 1; }
        ;;
    *.pf2)
        # PFF2 container: "FILE", 4-byte length, "PFF2".
        [ "$(head_hex "$path" 12)" = "46494c45""00000004""50464632" ] || { err "${root##*/}/$rel: not a PF2 font"; return 1; }
        ;;
    .complete) ;;
    *) err "${root##*/}/$rel: file type not allowed"; return 1 ;;
    esac
}

# validate_tree <root> [require-complete]: walks <root> (extracted copy, root
# owned) and checks the type, name, depth and file count of every entry.
validate_tree() {
    local root="$1" need_complete="$2" count=0 path rel type base depth
    while IFS= read -r -d '' type && IFS= read -r -d '' path; do
        [ "$path" != "$root" ] || continue
        rel=${path#"$root"/}
        base=${rel##*/}
        [[ "$base" =~ $NAME_RE ]] || { err "${root##*/}/$rel: bad name"; return 1; }
        depth=$(awk -F/ '{print NF}' <<<"$rel")
        [ "$depth" -le "$MAX_DEPTH" ] || { err "${root##*/}/$rel: nested too deep"; return 1; }
        case "$type" in
        d) ;;
        f)
            count=$((count + 1))
            [ "$count" -le "$MAX_FILES_PER_SHELL" ] || { err "too many files under ${root##*/}"; return 1; }
            check_file "$path" "$rel" || return 1
            ;;
        *) err "${root##*/}/$rel: not a regular file or directory"; return 1 ;;
        esac
    done < <(find "$root" -printf '%y\0%p\0')
    if [ "$need_complete" = 1 ] && [ ! -f "$root/.complete" ]; then
        err "${root##*/}: .complete marker missing (renderer not finished)"
        return 1
    fi
    [ ! "$need_complete" = 1 ] || [ -f "$root/theme.txt" ] || { err "${root##*/}: theme.txt missing"; return 1; }
    return 0
}

# ── Install ──────────────────────────────────────────────────────────────────
# copy_tree <src> <dst>: install every validated file 0644, dirs 0755,
# skipping the .complete marker (staging bookkeeping, not theme content).
copy_tree() {
    local src="$1" dst="$2" path rel
    install -d -m 0755 "$dst"
    while IFS= read -r -d '' path; do
        rel=${path#"$src"/}
        if [ -d "$path" ]; then
            install -d -m 0755 "$dst/$rel"
        elif [ "${rel##*/}" != .complete ]; then
            install -m 0644 "$path" "$dst/$rel"
        fi
    done < <(find "$src" -mindepth 1 -print0)
}

# swap_in <fresh> <final>: replace <final> by <fresh> with the shortest gap.
swap_in() {
    local fresh="$1" final="$2" old
    old="$(dirname "$final")/.old-$(basename "$final")"
    rm -rf "${old:?}"
    [ ! -e "$final" ] || mv -T "$final" "$old"
    mv -T "$fresh" "$final"
    rm -rf "${old:?}"
}

installed_shell_set() {
    local d
    for d in "$DEST"/*/; do
        [ -d "$d" ] || continue
        d=$(basename "$d")
        [ "$d" = "$ACTIVE_DIR_NAME" ] || echo "$d"
    done | sort
}

# ── Main ─────────────────────────────────────────────────────────────────────
WORK=$(mktemp -d) || die "mktemp failed"
RAW=""
fetch_staging

[ -d "$RAW/$FONTS_DIR_NAME" ] || die "staging has no $FONTS_DIR_NAME/ directory"
validate_tree "$RAW/$FONTS_DIR_NAME" 0 || die "fonts failed validation"
ls "$RAW/$FONTS_DIR_NAME"/*.pf2 >/dev/null 2>&1 || die "$FONTS_DIR_NAME/ holds no .pf2 fonts"

active_name=""
if [ -f "$RAW/active" ] && [ "$(file_size "$RAW/active")" -le 64 ]; then
    active_name=$(head -n1 "$RAW/active")
fi
[[ "$active_name" =~ $SHELL_RE ]] || die "staged 'active' file is missing or not a shell name"

valid=()
invalid=()
staged=()
for dir in "$RAW"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ "$name" != "$FONTS_DIR_NAME" ] || continue
    [[ "$name" =~ $SHELL_RE ]] || { err "ignoring staged directory with a bad shell name: $name"; continue; }
    staged+=("$name")
    [ "${#staged[@]}" -le "$MAX_SHELLS" ] || die "more than $MAX_SHELLS staged shells"
    if validate_tree "${dir%/}" 1; then
        valid+=("$name")
    else
        invalid+=("$name")
    fi
done
[ "${#valid[@]}" -gt 0 ] || die "no staged shell passed validation"

in_list "$active_name" "${valid[@]}" || die "active shell '$active_name' is not a valid staged shell"

install -d -m 0755 "$DEST"
before=$(installed_shell_set)
rm -rf "${DEST:?}"/.new-* "${DEST:?}"/.old-*

for name in "${valid[@]}"; do
    copy_tree "$RAW/$name" "$DEST/.new-$name"
    swap_in "$DEST/.new-$name" "$DEST/$name"
done

# active/ = the active shell's theme + the shared fonts at its top level, the
# fixed GRUB_THEME location. The marker is generated here, not staged content.
copy_tree "$RAW/$active_name" "$DEST/.new-$ACTIVE_DIR_NAME"
install -m 0644 "$RAW/$FONTS_DIR_NAME"/*.pf2 "$DEST/.new-$ACTIVE_DIR_NAME/"
printf '%s\n' "$active_name" >"$DEST/.new-$ACTIVE_DIR_NAME/$ACTIVE_MARKER"
chmod 0644 "$DEST/.new-$ACTIVE_DIR_NAME/$ACTIVE_MARKER"
swap_in "$DEST/.new-$ACTIVE_DIR_NAME" "$DEST/$ACTIVE_DIR_NAME"

# Drop installed shells that are no longer staged at all. A shell that is staged
# but failed validation keeps its previous good copy.
while IFS= read -r name; do
    [ -n "$name" ] || continue
    [[ "$name" =~ $SHELL_RE ]] || continue
    ! in_list "$name" "${staged[@]}" || continue
    log "removing $name (no longer staged)"
    rm -rf "${DEST:?}/$name"
done < <(installed_shell_set)

after=$(installed_shell_set)
log "installed: ${valid[*]}; active: $active_name"

if [ "$before" != "$after" ]; then
    log "shell set changed — regenerating grub.cfg"
    # shellcheck disable=SC2086  # intentional word split of the command
    $MKCONFIG_CMD || die "grub-mkconfig failed (grub.cfg left as it was)"
fi

if [ "${#invalid[@]}" -gt 0 ]; then
    die "kept previous copies of shells that failed validation: ${invalid[*]}"
fi
