# Template — scripts/install-grub-theme.sh substitutes @STAGING@ and
# installs the result as /etc/systemd/system/dcli-grub-theme.path.
[Unit]
Description=Watch the dcli GRUB theme staging tree

[Path]
# The renderer rewrites .stamp LAST after every successful render.
PathChanged=@STAGING@/.stamp
Unit=dcli-grub-theme.service

[Install]
WantedBy=multi-user.target
